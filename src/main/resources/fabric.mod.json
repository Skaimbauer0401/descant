{
  "schemaVersion": 1,
  "id": "descant",
  "version": "${version}",
  "name": "Descant",
  "description": "A client-side pathfinding bot you can talk to. Baritone-model navigation — walking, mining, bridging, parkour, ladders — driven either by /descant commands or by a language model through a typed action API.",
  "authors": [
    "Skaimbauer"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/descant",
    "sources": "https://github.com/Skaimbauer0401/descant",
    "issues": "https://github.com/Skaimbauer0401/descant/issues"
  },
  "license": "LGPL-3.0-only",
  "icon": "assets/descant/icon.png",
  "environment": "client",
  "entrypoints": {
    "fabric-datagen": [
      "descant.client.DescantDataGenerator"
    ],
    "client": [
      "descant.client.DescantClient"
    ],
    "main": [
      "descant.Descant"
    ]
  },
  "mixins": [
    "descant.mixins.json",
    {
      "config": "descant.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}"
  }
}
